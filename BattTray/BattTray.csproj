<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BattTray</RootNamespace>
    <AssemblyName>BattTray</AssemblyName>
    <ApplicationIcon>Assets\batttray-black.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shown on the exe's Properties > Details tab, which is the only place a user who
       downloaded a single unsigned file can check what they are about to run. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>BattTray</Product>
    <Authors>Jc Calayag</Authors>
    <Company>Jc Calayag</Company>
    <Copyright>Copyright (c) 2026 Jc Calayag</Copyright>
    <AssemblyTitle>BattTray</AssemblyTitle>
    <Description>Windows tray app showing the battery level of Bluetooth peripherals.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both variants ship inside the exe; the tray picks one to contrast the taskbar. -->
    <EmbeddedResource Include="Assets\batttray-black.ico" />
    <EmbeddedResource Include="Assets\batttray-white.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The diagnostics harness drives the real providers rather than a copy of them, which
         means reaching the internal device types. Nothing here is public API. -->
    <InternalsVisibleTo Include="BattTray.Diagnostics" />
  </ItemGroup>

  <!-- The app idles in the tray, so favour a small, quiet footprint over throughput. -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
